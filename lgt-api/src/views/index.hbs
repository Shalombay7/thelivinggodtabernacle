<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LGT Connect | The Living God Tabernacle</title>
  <style>
    :root {
      --primary: #1e3a8a;
      --accent: #d97706;
      --bg: #fdfbf7;
      --card: #ffffff;
      --text: #111827;
      --text-muted: #64748b;
      --success: #10b981;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }
    .card {
      background: var(--card);
      padding: 3rem;
      border-radius: 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
      width: 100%;
      max-width: 500px;
      text-align: center;
      border: 1px solid #f3f4f6;
    }
    h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2.25rem;
      color: var(--primary);
      font-family: 'Georgia', serif;
    }
    .tagline {
      color: var(--text-muted);
      margin-bottom: 2rem;
      font-style: italic;
    }
    .grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .feature-link {
      display: flex;
      align-items: center;
      padding: 1.25rem;
      background: #fff;
      border: 2px solid #f3f4f6;
      border-radius: 12px;
      text-decoration: none;
      color: var(--text);
      transition: all 0.3s ease;
    }
    .feature-link:hover {
      border-color: var(--accent);
      transform: translateX(5px);
      background: #fffdfa;
    }
    .feature-icon {
      font-size: 1.5rem;
      margin-right: 1rem;
    }
    .feature-text { text-align: left; }
    .feature-title { font-weight: 700; display: block; }
    .feature-desc { font-size: 0.8rem; color: var(--text-muted); }
    
    .footer {
      margin-top: 2rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>The Living God Tabernacle</h1>
    <p class="tagline">Overcoming together through faith and fellowship.</p>
    
    <div class="grid">
      <a href="/altar" class="feature-link">
        <span class="feature-icon">🔥</span>
        <div class="feature-text">
          <span class="feature-title">The Family Altar</span>
          <span class="feature-desc">Daily devotionals for your household.</span>
        </div>
      </a>
      <a href="/connect" class="feature-link">
        <span class="feature-icon">🤝</span>
        <div class="feature-text">
          <span class="feature-title">Fellowship Groups</span>
          <span class="feature-desc">Find a community near you.</span>
        </div>
      </a>
      <a href="/docs" class="feature-link">
        <span class="feature-icon">📖</span>
        <div class="feature-text">
          <span class="feature-title">Bible API Docs</span>
          <span class="feature-desc">Developer resources and health.</span>
        </div>
      </a>
    </div>

    <div class="footer">
      <p>System Status: <span style="color:var(--success)">Healthy</span> • Version 1.0.0</p>
    </div>
  </div>
</body>
</html>