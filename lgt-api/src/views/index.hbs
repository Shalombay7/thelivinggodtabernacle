<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{meta.description}}" />
  <title>{{meta.title}}</title>
  <link rel="stylesheet" href="/styles/home.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <div class="page-shell" id="top">
    {{> site-header}}

    <main id="main-content">
      {{> hero}}
      {{> belief-strip}}
      {{> message-section}}

      <section class="content-section" id="gather" aria-labelledby="gather-title">
        <div class="section-heading">
          <p class="eyebrow">Worship and gathering</p>
          <h2 id="gather-title">Join us in person, live, or on the radio.</h2>
          <p>{{churchInfo.serviceTime}}</p>
        </div>

        <div class="card-grid card-grid--three">
          {{#each gatheringCards}}
            {{> resource-card}}
          {{/each}}
        </div>
      </section>

      <section class="content-section" id="resources" aria-labelledby="resources-title">
        <div class="section-heading">
          <p class="eyebrow">Legacy resources, modernized</p>
          <h2 id="resources-title">The existing ministry features are now clearer paths.</h2>
          <p>Sermons, songs, Bible Q&A, teachings, videos, radio, and gallery content remain visible while the app grows native versions of each feature.</p>
        </div>

        <div class="card-grid card-grid--three">
          {{#each resources}}
            {{> resource-card}}
          {{/each}}
        </div>
      </section>

      <section class="content-section" id="modules" aria-labelledby="modules-title">
        <div class="section-heading">
          <p class="eyebrow">App modules</p>
          <h2 id="modules-title">Built for discipleship across every stage of life.</h2>
          <p>These modules keep the homepage aligned with the long-term platform vision instead of being only a static landing page.</p>
        </div>

        <div class="module-grid">
          {{#each appModules}}
            {{> module-card}}
          {{/each}}
        </div>
      </section>

      <section class="prayer-section" id="prayer" aria-labelledby="prayer-title">
        <div>
          <p class="eyebrow">{{prayer.eyebrow}}</p>
          <h2 id="prayer-title">{{prayer.title}}</h2>
          <p>{{prayer.body}}</p>
          <div class="action-row">
            {{#each prayer.actions}}
              <a
                class="button button--{{variant}}"
                href="{{url}}"
                target="{{target}}"
                rel="{{rel}}"
              >
                {{label}}
              </a>
            {{/each}}
          </div>
        </div>
      </section>

      <section class="content-section content-section--compact" aria-labelledby="questions-title">
        <div class="section-heading">
          <p class="eyebrow">Recent Bible questions</p>
          <h2 id="questions-title">Keep the Q&A library discoverable.</h2>
        </div>

        <div class="question-list">
          {{#each recentQuestions}}
            <a href="{{url}}" target="{{target}}" rel="{{rel}}">
              <span>{{title}}</span>
              <span aria-hidden="true">→</span>
            </a>
          {{/each}}
        </div>
      </section>
    </main>

    {{> site-footer}}
  </div>
</body>
</html>
